{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "table_gen/manifest_v1.json",
  "title": "Content Pack Manifest v1",
  "type": "object",
  "required": [
    "manifest_version",
    "pack_id",
    "source",
    "composition",
    "palette",
    "steps",
    "assets",
    "vector_assets"
  ],
  "properties": {
    "manifest_version": {
      "const": "v1"
    },
    "pack_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": ["mode", "job_id", "theme", "difficulty", "generator_backend"],
      "properties": {
        "mode": { "enum": ["generate", "library"] },
        "job_id": { "type": "string", "minLength": 1 },
        "theme": { "type": "string", "minLength": 1 },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "generator_backend": { "enum": ["mock", "comfyui", "nano_banana_pro"] }
      },
      "additionalProperties": false
    },
    "composition": {
      "type": "object",
      "required": ["candidate_id"],
      "properties": {
        "candidate_id": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "palette": {
      "type": "object",
      "required": ["colors"],
      "properties": {
        "colors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "pattern": "^#[0-9A-F]{6}$"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["step_index", "color", "layer_mask", "cumulative_state"],
        "properties": {
          "step_index": { "type": "integer", "minimum": 1 },
          "color": { "type": "string", "pattern": "^#[0-9A-F]{6}$" },
          "layer_mask": { "type": "string", "minLength": 1 },
          "cumulative_state": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "object",
      "required": ["preview"],
      "properties": {
        "preview": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "vector_assets": {
      "type": "object",
      "required": ["master_svg", "color_layers"],
      "properties": {
        "master_svg": { "type": "string", "minLength": 1 },
        "color_layers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["color", "path"],
            "properties": {
              "color": { "type": "string", "pattern": "^#[0-9A-F]{6}$" },
              "path": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
