+// ReconcileInterrupted makes restart semantics explicit. A persisted non-terminal
+// job is never resumed blindly: it becomes a terminal failure and remains available
+// for operator inspection or explicit rollback when the old image was captured.
+func (s *Store) ReconcileInterrupted(now time.Time) error {
+	for _, job := range s.List() {
+		switch job.State {
+		case "COMPLETED", "ROLLED_BACK", "FAILED", "ROLLBACK_FAILED":
+			continue
+		}
+		finished := now.UTC()
+		job.State = "FAILED"
+		job.Message = "updater restarted before the job reached a terminal state; inspect and request rollback explicitly"
+		job.UpdatedAt = finished
+		job.FinishedAt = &finished
+		if err := s.Save(job); err != nil {
+			return err
+		}
+	}
+	return nil
+}
