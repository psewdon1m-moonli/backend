@@ -0,0 +1,39 @@
+package state
+
+import (
+	"testing"
+	"time"
+
+	"updater/internal/model"
+)
+
+func TestReconcileInterruptedMarksPersistedJobFailed(t *testing.T) {
+	directory := t.TempDir()
+	store, err := New(directory)
+	if err != nil {
+		t.Fatal(err)
+	}
+	created := time.Date(2026, 9, 4, 0, 0, 0, 0, time.UTC)
+	job := model.Job{
+		ID: "interrupted", RequestID: "request", HeadID: "moonli", Service: "moonli",
+		State: "APPLYING", CreatedAt: created, UpdatedAt: created, RollbackAvailable: true,
+	}
+	if err := store.Save(job); err != nil {
+		t.Fatal(err)
+	}
+	reloaded, err := New(directory)
+	if err != nil {
+		t.Fatal(err)
+	}
+	reconciledAt := created.Add(time.Minute)
+	if err := reloaded.ReconcileInterrupted(reconciledAt); err != nil {
+		t.Fatal(err)
+	}
+	got, ok := reloaded.Get(job.ID)
+	if !ok || got.State != "FAILED" || got.FinishedAt == nil {
+		t.Fatalf("interrupted job was not reconciled: %#v", got)
+	}
+	if !got.RollbackAvailable {
+		t.Fatal("explicit rollback availability must be preserved")
+	}
+}
