map $host $moonli_host_allowed {
    default 0;
    "${MOONLI_DOMAIN}" 1;
}

limit_req_zone $binary_remote_addr zone=moonli_login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=moonli_generate:10m rate=30r/m;

upstream moonli_api {
    server api:8000;
    keepalive 8;
}

server {
    listen 80 default_server;
    server_name _;
    server_tokens off;

    if ($moonli_host_allowed = 0) {
        return 421;
    }

    return 308 https://${MOONLI_DOMAIN}$request_uri;
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name _;
    server_tokens off;

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:MoonliTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    if ($moonli_host_allowed = 0) {
        return 421;
    }

    client_max_body_size ${MOONLI_MAX_REQUEST_BODY};
    client_body_timeout 30s;
    client_header_timeout 15s;
    keepalive_timeout 30s;
    send_timeout 300s;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' blob: data:; style-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" always;
    add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    proxy_hide_header Server;

    location = /health {
        proxy_pass http://moonli_api;
        proxy_set_header Host ${MOONLI_DOMAIN};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = / {
        proxy_pass http://moonli_api;
        proxy_set_header Host ${MOONLI_DOMAIN};
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /web/ {
        proxy_pass http://moonli_api;
        proxy_set_header Host ${MOONLI_DOMAIN};
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /internal/production/config {
        proxy_pass http://moonli_api;
        proxy_set_header Host ${MOONLI_DOMAIN};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /internal/production/google-key {
        proxy_pass http://moonli_api;
        proxy_set_header Host ${MOONLI_DOMAIN};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /internal/production/stats {
        proxy_pass http://moonli_api;
        proxy_set_header Host ${MOONLI_DOMAIN};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /internal/production/pipelines/ {
        proxy_pass http://moonli_api;
        proxy_set_header Host ${MOONLI_DOMAIN};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /internal/auth/session {
        limit_req zone=moonli_login burst=3 nodelay;
        proxy_pass http://moonli_api;
        proxy_set_header Host ${MOONLI_DOMAIN};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /internal/auth/rotate-access-key {
        limit_req zone=moonli_login burst=2 nodelay;
        proxy_pass http://moonli_api;
        proxy_set_header Host ${MOONLI_DOMAIN};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /internal/settings {
        proxy_pass http://moonli_api;
        proxy_set_header Host ${MOONLI_DOMAIN};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /internal/routing {
        proxy_pass http://moonli_api;
        proxy_set_header Host ${MOONLI_DOMAIN};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /internal/test/ {
        proxy_pass http://moonli_api;
        proxy_set_header Host ${MOONLI_DOMAIN};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }

    location /internal/operations/ {
        proxy_pass http://moonli_api;
        proxy_set_header Host ${MOONLI_DOMAIN};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /internal/devices {
        proxy_pass http://moonli_api;
        proxy_set_header Host ${MOONLI_DOMAIN};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /internal/backups {
        proxy_pass http://moonli_api;
        proxy_set_header Host ${MOONLI_DOMAIN};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_request_buffering off;
    }

    location /internal/updates/ {
        proxy_pass http://moonli_api;
        proxy_set_header Host ${MOONLI_DOMAIN};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    location = /v1/generate {
        limit_req zone=moonli_generate burst=10 nodelay;
        proxy_pass http://moonli_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host ${MOONLI_DOMAIN};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }

    location = /v1/normalize {
        limit_req zone=moonli_generate burst=10 nodelay;
        proxy_pass http://moonli_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host ${MOONLI_DOMAIN};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_buffering off;
    }

    location / {
        return 404;
    }
}
