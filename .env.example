# Local validation mode. Change to production on the server.
MOONLI_ENV=development
MOONLI_DOMAIN=localhost
MOONLI_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Google production credentials are written by the authenticated Production UI
# to the dedicated moonli_secrets Docker volume, never to this file.

# Credentials authenticate clients; the request's required pipeline tag selects
# pipeline-1 or pipeline-2. Use unique random credentials in production.
MOONLI_OPERATOR_ACCESS_KEY=dev-moonli-operator-key-01
MOONLI_CLIENT_API_KEYS=dev-moonli-client-key

# In development Nginx creates a temporary self-signed certificate in a Docker
# volume. On the server set this to a directory containing fullchain.pem and privkey.pem.
# MOONLI_TLS_CERTS_PATH=/srv/moonli/tls

# Local end-to-end tests use real PNG artifacts from explicit mock providers.
MOONLI_IMAGE_PROVIDER=mock
MOONLI_TRANSCRIPTION_PROVIDER=mock
MOONLI_NORMALIZATION_PROVIDER=mock

# Configure model names before production. Set the Google key in the Production UI.
MOONLI_GOOGLE_IMAGE_MODEL=
MOONLI_GOOGLE_TRANSCRIPTION_MODEL=
MOONLI_GOOGLE_NORMALIZATION_MODEL=
MOONLI_GOOGLE_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
MOONLI_GOOGLE_TIMEOUT_SECONDS=180
MOONLI_GOOGLE_IMAGE_ASPECT_RATIO=1:1
MOONLI_GOOGLE_IMAGE_SIZE=1K

MOONLI_MAX_TEXT_LENGTH=12000
MOONLI_MAX_AUDIO_SIZE=20971520
# Nginx size syntax: use m, not the Caddy-style MB suffix.
MOONLI_MAX_REQUEST_BODY=22m
MOONLI_PALETTE_SNAP_DISTANCE=12
MOONLI_PALETTE_CLEANUP_PASSES=1
MOONLI_PALETTE_GENERATION_ATTEMPTS=3
MOONLI_REQUESTS_PER_MINUTE=30
MOONLI_CONCURRENT_REQUESTS_PER_CLIENT=2
MOONLI_STAGING_RETENTION_HOURS=24
MOONLI_INPUT_RETENTION_HOURS=24
MOONLI_COMPLETED_RETENTION_DAYS=30
MOONLI_IN_PROGRESS_STALE_MINUTES=30
MOONLI_USAGE_RETENTION_DAYS=365
MOONLI_USAGE_MAX_ROWS=1000000

# Browser CORS is disabled unless explicit debug origins are listed.
MOONLI_CORS_ORIGINS=
